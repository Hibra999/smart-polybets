# ── Conexión con el Django App (polymarket-portfolio) ────────────────────────
# El repo NUNCA escribe a una DB propia: todo el estado vive en el Django App.
DJANGO_API_BASE=http://localhost:8000/api/agent
DJANGO_API_KEY=secret-internal-token-aqui

# ── Polymarket CLOB V2 — EJECUCIÓN REAL (SDK oficial, colateral pUSD) ──────────
# Por defecto el broker corre en DRY-RUN. Para órdenes reales: la private key +
# POLYMARKET_LIVE=1. El SDK V2 DERIVA solo el proxy wallet y los contratos pUSD,
# así que NO hace falta funder ni signature_type (el funder es opcional, override).

# Llave de la wallet (MetaMask) que firma las órdenes (¡SECRETO! nunca commitear).
POLYMARKET_PRIVATE_KEY=

# Opcional: forzar el proxy wallet (si no, el SDK lo deriva de la key).
POLYMARKET_FUNDER=

# Interruptor maestro de ejecución real. Sin esto en "1", el broker NUNCA envía.
POLYMARKET_LIVE=0
# Kill-switch de emergencia: ponelo en 1 para bloquear toda ejecución real.
POLYMARKET_KILL_SWITCH=0

# ── Rutas locales ────────────────────────────────────────────────────────────
# Raíz de los SQLite por torneo (default: ./data)
DATA_ROOT=data
