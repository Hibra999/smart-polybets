# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Datos generados (las DB se construyen con scripts/build_db.py)
data/**/*.sqlite
data/**/*.sqlite-journal

# Estado local del agente (idempotencia/registro de apuestas)
data/agent_state.json

# Reportes generados por editorial/
editorial/reports/**/*.md
!editorial/reports/.gitkeep

# Reports NFL 2025 con data embebida ENORME (>100MB) — GitHub rechaza archivos
# >100MB. Se regeneran con scripts/nfl_*_report.py; NUNCA versionar (2026-08-22).
editorial/reports/nfl_2026/2026-06-21_all_strategies_2025.html
editorial/reports/nfl_2026/2026-06-21_weekly_trueskill_fav_2025.html
editorial/reports/nfl_2026/2026-06-21_backtest_2025.html
editorial/reports/nfl_2026/2026-06-21_weekly_trueskill_dog_2025.html

# Entorno
.env

# Claude Code: overrides personales del proyecto (settings del equipo SÍ se versionan)
.claude/settings.local.json

# graphify: grafo de conocimiento generado (AST local; se reconstruye con `graphify update .`)
graphify-out/

# SDD scratch (progreso de refactor, no versionar)
.superpowers/

# Backups locales (ingesta/sync) — nunca versionar
data/**/*.bak-*

# Ticks de mercado (recorder por minuto — crece sin límite, no se versiona)
data/*/market_ticks.sqlite*

# EXCEPCIÓN: los exports por evento SÍ se versionan (dataset finito y cerrado;
# acordado 2026-07-14: la data de mercado queda por torneo y por evento)
!data/*/events/**/*.sqlite
